# Isolated runtime for candidate strategy code (SandboxConfig.isolation = "docker").
# Build: docker build -f Dockerfile.sandbox -t quant-research-sandbox:latest .
# Versions mirror uv.lock so plugin results match the research environment.
FROM python:3.12-slim
RUN pip install --no-cache-dir numpy==2.5.4 pandas==3.0.6 pyarrow==26.0.0 pydantic==2.14.1 \
    && useradd --create-home --uid 10001 sandbox
USER sandbox
WORKDIR /work
