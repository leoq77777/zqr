{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "research_id",
    "task_id",
    "hypothesis",
    "preregistered_plan",
    "experiment_ids",
    "strategy_artifacts",
    "decision",
    "limitations",
    "sources",
    "unresolved",
    "final_artifact"
  ],
  "properties": {
    "research_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "preregistered_plan": {
      "type": "object"
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "strategy_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "decision": {
      "enum": [
        "continue",
        "revise",
        "reject",
        "insufficient_evidence"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_artifact": {
      "description": "The single strategy you submit as your result: the workspace file, its sha256, the exact parameters, and the id of a completed experiment that ran exactly this file with exactly these parameters. null when you recommend no strategy.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "parameters",
            "experiment_id"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "parameters": {
              "type": "object"
            },
            "experiment_id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "results": {
      "description": "Numbers you cite, verified against the experiment records.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "experiment_id",
          "metrics"
        ],
        "properties": {
          "experiment_id": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
