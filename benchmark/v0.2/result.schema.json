{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "benchmark v0.2 run result",
  "type": "object",
  "required": [
    "schema_version", "run_id", "task_id", "repeat", "track", "adapter", "harness_version", "model_id", "provider",
    "config_hash", "identity", "status", "failure_class", "failure_details", "score", "cost_estimated_usd",
    "cost_billed_usd", "usage", "wall_seconds", "backtest_seconds", "model_requests", "experiments_submitted",
    "hard_failures", "attempted_violations", "violations", "network_isolation", "audit", "faults",
    "submission_sha256", "rubric_items", "unavailable_fields", "report_path"
  ],
  "properties": {
    "schema_version": {"const": "v0.2"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "repeat": {"type": "integer"},
    "track": {"enum": ["product", "controlled_model", "patch_ablation", "team_ablation"]},
    "adapter": {"type": "string"},
    "harness_version": {"type": "string"},
    "model_id": {"type": "string"},
    "provider": {"type": "string"},
    "config_hash": {"type": "string", "description": "hash of identity: equal hashes = same configuration"},
    "identity": {"type": "object"},
    "status": {"enum": ["passed", "failed", "invalid", "incomplete"]},
    "failure_class": {"enum": [
      "none", "harness.error", "harness.crash", "audit.failed", "environment.model_unreachable",
      "environment.docker", "agent.killed", "agent.timeout", "agent.error", "agent.no_deliverable",
      "grade.hard_failure", "grade.critical_item", "grade.below_threshold"
    ]},
    "failure_details": {"type": "array", "items": {"type": "string"}},
    "score": {"type": ["number", "null"]},
    "cost_estimated_usd": {"type": ["number", "null"]},
    "cost_billed_usd": {"type": ["number", "null"]},
    "usage": {"type": ["object", "null"]},
    "usage_source": {"enum": ["cli_result", "transcript", null],
                     "description": "cli_result: the CLI's final JSON; transcript: rebuilt from the session transcript (agent killed or harness crashed)"},
    "wall_seconds": {"type": ["number", "null"]},
    "backtest_seconds": {"type": ["number", "null"]},
    "model_requests": {"type": ["integer", "null"]},
    "experiments_submitted": {"type": "integer"},
    "hard_failures": {"type": "array", "items": {"type": "string"}},
    "attempted_violations": {"type": "array", "items": {"type": "string"}},
    "violations": {
      "type": "object",
      "required": ["tool_policy", "gatekeeper", "network", "grader"],
      "properties": {
        "tool_policy": {"type": "array"}, "gatekeeper": {"type": "array"},
        "network": {"type": "array"}, "grader": {"type": "array"}
      },
      "additionalProperties": false
    },
    "network_isolation": {"enum": ["egress_proxy", "none"]},
    "audit": {"type": "object", "required": ["ok", "problems"]},
    "faults": {"type": "array", "items": {
      "type": "object", "required": ["fault", "outcome", "evidence"],
      "properties": {"fault": {"type": "string"},
                     "outcome": {"enum": ["recovered", "safe_stop", "unsafe", "not_triggered"]},
                     "evidence": {"type": "string"}}}},
    "submission_sha256": {"type": ["string", "null"]},
    "rubric_items": {"type": "array"},
    "unavailable_fields": {"type": "array", "items": {"type": "string"}},
    "report_path": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
