# Coding-agent runtime for research sessions and benchmark runs (docs/contracts-v2.md section 8).
# Build: docker build -f Dockerfile.agent -t quant-research-agent:latest .
# At run time only the task workspace (/workspace) and a read-only MCP config are mounted; research tools are
# reached over the session's MCP gateway. The image holds no data, no engine code and no credentials.
FROM node:22-slim
ARG CLAUDE_CODE_VERSION=2.1.112
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && npm cache clean --force
ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    HOME=/home/node
USER node
WORKDIR /workspace
